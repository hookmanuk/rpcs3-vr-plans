+// One update's camera against the car: every 250 ms, and each update for half a second after anything sudden.
+void HoldDiagLog(uint8_t* base, const float (&game)[16], const float (&held)[16], const float (&out)[16],
+                 const float* pose, bool learn, bool readback) {
+  static int calls[2][2]{};
+  ++calls[learn][readback];
+  const uint32_t car_address = g_car_matrix.load(std::memory_order_relaxed);
+  float rows[3][3]{}, position[3]{}, lengths[3]{};
+  bool car_ok = car_address != 0;
+  for (int r = 0; r < 3 && car_ok; ++r) {
+    float length = 0.f;
+    for (int c = 0; c < 3; ++c) {
+      rows[r][c] = LoadFloat(base + car_address + 16 * r + 4 * c);
+      length += rows[r][c] * rows[r][c];
+    }
+    lengths[r] = std::sqrt(length);
+    car_ok = lengths[r] > 1e-3f;
+    if (car_ok) {
+      for (float& v : rows[r]) {
+        v /= lengths[r];
+      }
+    }
+    position[r] = LoadFloat(base + car_address + 48 + 4 * r);
+  }
+  const auto in_body = [&](const float (&matrix)[16], float (&local)[3]) {
+    for (int r = 0; r < 3; ++r) {
+      local[r] = (matrix[12] - position[0]) * rows[r][0] + (matrix[13] - position[1]) * rows[r][1] +
+                 (matrix[14] - position[2]) * rows[r][2];
+    }
+  };
+  float local_game[3], local_held[3], local_out[3];
+  in_body(game, local_game);
+  in_body(held, local_held);
+  in_body(out, local_out);
+  const auto distance = [](const float* a, const float* b) {
+    return std::sqrt((a[0] - b[0]) * (a[0] - b[0]) + (a[1] - b[1]) * (a[1] - b[1]) + (a[2] - b[2]) * (a[2] - b[2]));
+  };
+  static float learnt_out[3];
+  static int disagreements = 0;
+  if (!learn) {  // the frame's other setting of the camera: does it agree with the first?
+    disagreements += distance(local_out, learnt_out) > 0.1f;
+    return;
+  }
+  static float last_game[3], last_out[3], last_pose[3], last_position[3];
+  static uint32_t last_car = 0, last_camera = 0;
+  static bool last_held = false;
+  static int burst = 0;
+  static auto last_line = std::chrono::steady_clock::now();
+  const bool is_held = std::memcmp(game + 12, held + 12, 12) != 0;
+  const uint32_t camera = g_diag_camera.load(std::memory_order_relaxed);
+  const float along = game[8] * rows[2][0] + game[9] * rows[2][1] + game[10] * rows[2][2];
+  const float d_game = distance(local_game, last_game), d_out = distance(local_out, last_out),
+              d_pose = distance(pose + 12, last_pose), d_car = distance(position, last_position);
+  const char* event = !car_ok                   ? nullptr
+                      : is_held != last_held    ? (is_held ? "HOLD ON" : "HOLD OFF")
+                      : car_address != last_car ? "CAR CHANGED"
+                      : camera != last_camera   ? "CAMERA OBJECT CHANGED"
+                      : d_game > 0.1f           ? "GAME CAMERA JUMP IN BODY"
+                      : d_out > 0.1f            ? "FINAL CAMERA JUMP IN BODY"
+                      : d_pose > 0.1f           ? "HEAD POSE JUMP"
+                      : d_car > 3.f             ? "CAR WORLD JUMP"
+                                                : nullptr;
+  if (event && DiagEvent()) {
+    REXLOG_INFO("HOLDDIAG EVENT {}: moved game {:.3f} final {:.3f} head {:.3f} car(world) {:.3f}", event, d_game, d_out,
+                d_pose, d_car);
+    burst = 36;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if ((burst > 0 && DiagEvent()) || now - last_line > std::chrono::milliseconds(250)) {
+    burst = std::max(0, burst - 1);
+    last_line = now;
+    const uint32_t target = car_address > 272 ? car_address - 272 : 0;
+    float chassis_local[3]{};
+    uint32_t chassis = 0, camera_vtable = 0, target_vtable = 0;
+    if (target && !IsBadReadPtr(base + target, 32)) {
+      target_vtable = LoadU32(base + target);
+      chassis = LoadU32(base + target + 28);
+      if (chassis && !IsBadReadPtr(base + chassis + 16, 64)) {
+        const float p[3] = {LoadFloat(base + chassis + 16 + 48), LoadFloat(base + chassis + 16 + 52),
+                            LoadFloat(base + chassis + 16 + 56)};
+        for (int r = 0; r < 3; ++r) {
+          chassis_local[r] = (p[0] - position[0]) * rows[r][0] + (p[1] - position[1]) * rows[r][1] +
+                             (p[2] - position[2]) * rows[r][2];
+        }
+      }
+    }
+    if (camera && !IsBadReadPtr(base + camera, 4)) {
+      camera_vtable = LoadU32(base + camera);
+    }
+    REXLOG_INFO(
+        "HOLDDIAG {} sway {} panel {} car {:08X} cam {:08X}/{:08X} target-vt {:08X} chassis {:08X} | game {:.3f} {:.3f} "
+        "{:.3f} held {:.3f} {:.3f} {:.3f} final {:.3f} {:.3f} {:.3f} seat {} {:.3f} {:.3f} {:.3f} | along {:.3f} scale "
+        "{:.3f} {:.3f} {:.3f} chassis-in-body {:.3f} {:.3f} {:.3f} head {:.3f} {:.3f} {:.3f} | carstep {:.4f} still {} "
+        "calls first {}+{} second {}+{} disagree {}",
+        is_held ? "HELD" : "free", bool(REXCVAR_GET(vr_cockpit_sway)), vr::UiPanel(), car_address, camera, camera_vtable,
+        target_vtable, chassis, local_game[0], local_game[1], local_game[2], local_held[0], local_held[1], local_held[2],
+        local_out[0], local_out[1], local_out[2], g_hold_diag.have_seat, g_hold_diag.seat[0], g_hold_diag.seat[1],
+        g_hold_diag.seat[2], along, lengths[0], lengths[1], lengths[2], chassis_local[0], chassis_local[1],
+        chassis_local[2], pose[12], pose[13], pose[14], d_car, g_hold_diag.still, calls[1][0], calls[1][1], calls[0][0],
+        calls[0][1], disagreements);
+    std::memset(calls, 0, sizeof(calls));
+    disagreements = 0;
+  }
+  std::memcpy(learnt_out, local_out, sizeof(local_out));
+  std::memcpy(last_game, local_game, sizeof(local_game));
+  std::memcpy(last_out, local_out, sizeof(local_out));
+  std::memcpy(last_pose, pose + 12, sizeof(last_pose));
+  std::memcpy(last_position, position, sizeof(position));
+  last_car = car_address;
+  last_camera = camera;
+  last_held = is_held;
+}
