+std::string VrLastResolveAt(uint32_t address) {
+  std::scoped_lock lock{g_vr_resolve_note_mutex};
+  auto it = g_vr_resolve_notes.find(address);
+  return it == g_vr_resolve_notes.end() ? "none" : it->second + fmt::format(", now {}", g_vr_resolve_count);
+}
