+std::mutex g_vr_resolve_note_mutex;
+std::map<uint32_t, std::string> g_vr_resolve_notes;
+uint64_t g_vr_resolve_count = 0;
+void VrNoteResolve(uint32_t address, bool depth, uint32_t format) {
+  std::scoped_lock lock{g_vr_resolve_note_mutex};
+  ++g_vr_resolve_count;
+  g_vr_resolve_notes[address] = fmt::format("{} fmt {} (resolve #{})", depth ? "depth" : "colour", format,
+                                            g_vr_resolve_count);
